# Copy to .env and fill in locally. Never commit .env.
DATABASE_URL=postgresql://regengine:change-me@localhost:5432/regengine
POSTGRES_PASSWORD=change-me

# LLM provider (Anthropic API). Model id is configuration, never a constant.
LLM_PROVIDER=anthropic
LLM_MODEL_ID=claude-opus-5-5
EVAL_MODEL_ID=claude-sonnet-5-5
ANTHROPIC_COVER_API_KEY=replace-me

# Embeddings (local, via fastembed)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Admin review screen (both required; hash from `uv run python -m app.api.auth`; quote it in .env)
ADMIN_USERNAME=
ADMIN_PASSWORD_SCRYPT=

# docker compose only: public hostname for HTTPS (Caddy gets a certificate), and host ports
SITE_ADDRESS=:80
WEB_PORT=8080
TLS_PORT=8443

# Hosted demo: invite code visitors must enter (empty = no gate), and feedback retention
DEMO_INVITE_CODE=
FEEDBACK_RETENTION_DAYS=14
