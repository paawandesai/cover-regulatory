# Copy to .env and fill in locally. Never commit .env.
DATABASE_URL=postgresql+psycopg://regengine:change-me@localhost:5432/regengine
POSTGRES_PASSWORD=change-me

# LLM provider (Anthropic API). Model id is configuration, never a constant.
LLM_PROVIDER=anthropic
LLM_MODEL_ID=claude-opus-5-5
ANTHROPIC_COVER_API_KEY=replace-me

# Embeddings (local, via fastembed)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Admin auth (admin routes only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-me

# Self-hosted Langfuse (optional compose profile)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me

# Salt for hashing APNs in logs
LOG_ID_SALT=replace-me
