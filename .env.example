# Copy to .env and fill in locally. Never commit .env. Placeholders only; settings in the environment win over .env.
DATABASE_URL=postgresql://regengine:change-me@localhost:5432/regengine
POSTGRES_PASSWORD=change-me

# LLM provider (Anthropic API). Model ids are configuration, never constants: with LLM_MODEL_ID unset the chat is off
# and extraction refuses to run. Check Anthropic's model deprecations page before changing them.
LLM_PROVIDER=anthropic
LLM_MODEL_ID=claude-opus-5-5
EVAL_MODEL_ID=claude-sonnet-5-5
ANTHROPIC_COVER_API_KEY=replace-me
# ANTHROPIC_API_KEY is also accepted locally in place of ANTHROPIC_COVER_API_KEY.

# Embeddings (local, via fastembed)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Admin review screen (both required; hash from `uv run python -m app.api.auth`; quote it in .env)
ADMIN_USERNAME=
ADMIN_PASSWORD_SCRYPT=

# docker compose only: public hostname for HTTPS (Caddy gets a certificate), and host ports
SITE_ADDRESS=:80
WEB_PORT=8080
TLS_PORT=8443

# Hosted demo: invite code visitors must enter (empty = no gate), and feedback/report retention
DEMO_INVITE_CODE=
FEEDBACK_RETENTION_DAYS=14

# Client address for rate limits: behind Caddy set TRUST_PROXY_HEADERS=true (compose does); behind CloudFront + ALB
# also set TRUSTED_PROXY_HOPS=2.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# Swagger UI and OpenAPI schema at /api/docs (keep off on a deployment)
API_DOCS=false

# Ingestion and the weekly source check
ARCGIS_PAGE_DELAY_S=0.25
HTTP_USER_AGENT="cover-regulatory-poc/0.1 (research prototype)"
REGTEXT_RAW_DIR=
MANUAL_RECHECK_DAYS=90
# Weight of full-text search in the hybrid ranking (0 = embeddings and section ids only; see eval/retrieval/results.md)
SEARCH_FTS_WEIGHT=0

# Frontend dev server only: where `npm run dev` proxies /api
API_URL=http://127.0.0.1:8000
